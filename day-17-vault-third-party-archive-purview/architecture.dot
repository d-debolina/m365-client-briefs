digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.45, ranksep=0.7, bgcolor="white",
         label=<<b>Day 17 · VAULT — Validate, Archive, Unify, Legal-hold, Trace</b><br/><font point-size="13" color="#6B7280">Third-party archive into Purview: the right connector, retention, holds via Graph, and provable integrity<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=10, color="#4B5563", fontcolor="#374151", arrowsize=0.7];
  arch [label=<<b>Third-party archive</b><br/><font point-size="10">email · chat · SMS</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  hash [label=<<b>integrity_manifest.py</b><br/><font point-size="10">SHA-256 before/after</font>>, fillcolor="#FEF9C3", color="#A16207"];
  subgraph cluster_pv { label=<<b>Microsoft Purview (customer tenant)</b>>; fontsize=13; style="rounded,dashed"; color="#C2410C"; fontcolor="#C2410C";
  dc [label=<<b>Data connector</b><br/><font point-size="10">native · partner · custom import</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  ret [label=<<b>Retention labels</b><br/><font point-size="10">auto-apply · records</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  ed [label=<<b>eDiscovery case</b><br/><font point-size="10">custodians · hold · search · export</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  }
  subgraph cluster_m365 { label=<<b>Microsoft 365</b>>; fontsize=13; style="rounded,dashed"; color="#0369A1"; fontcolor="#0369A1";
  mbx [label=<<b>Custodian mailboxes</b><br/><font point-size="10">imported items</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  }
  gapi [label=<<b>Graph eDiscovery API</b><br/><font point-size="10">app reg in customer tenant<br/>eDiscovery.ReadWrite.All</font>>, fillcolor="#E0F7F4", color="#0F766E"];
  cc [label=<<b>Copilot connector</b><br/><font point-size="10">search/Copilot only, not compliance</font>>, fillcolor="#FEF9C3", color="#A16207"];
  arch -> hash [style=dashed]; arch -> dc; dc -> mbx; ret -> mbx [style=dotted]; ed -> mbx [label="hold + search"];
  gapi -> ed [label="automate"]; ed -> hash [label="export → compare", style=dashed]; arch -> cc [style=dotted, label="not for holds"];
}
