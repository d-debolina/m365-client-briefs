digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.45, ranksep=0.7, bgcolor="white",
         label=<<b>Day 3 · HIRE — HR Intake, Requisition &amp; Enrolment</b><br/><font point-size="13" color="#6B7280">Lists-first HR service centre with multistage (AI + human) approvals<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=10, color="#4B5563", fontcolor="#374151", arrowsize=0.7];
  mgr [label=<<b>Hiring manager</b>>, fillcolor="#F3F4F6", color="#6B7280"];
  hr [label=<<b>HR team</b>>, fillcolor="#F3F4F6", color="#6B7280"];
  subgraph cluster_m365 { label=<<b>Microsoft 365</b>>; fontsize=13; style="rounded,dashed"; color="#0369A1"; fontcolor="#0369A1";
  form [label=<<b>Intake form</b><br/><font point-size="10">Microsoft Forms / Lists form</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  req [label=<<b>SharePoint Lists</b><br/><font point-size="10">Requisitions · ApprovalMatrix<br/>Candidates · OnboardingTasks</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  teams [label=<<b>Teams</b><br/><font point-size="10">approval cards · notifications</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  planner [label=<<b>Planner</b><br/><font point-size="10">onboarding checklist</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  }
  subgraph cluster_pp { label=<<b>Power Platform</b>>; fontsize=13; style="rounded,dashed"; color="#7C3AED"; fontcolor="#7C3AED";
  ms [label=<<b>Agent flow: multistage approval</b><br/><font point-size="10">AI stage → Budget owner → HR</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  onb [label=<<b>Cloud flow</b><br/><font point-size="10">status = Hired → create tasks</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  }
  ai [label=<<b>AI approval stage</b><br/><font point-size="10">checks against ApprovalMatrix</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  bi [label=<<b>Power BI (optional)</b><br/><font point-size="10">time-to-hire</font>>, fillcolor="#FEF9C3", color="#A16207"];
  mgr -> form [label="new role"]; form -> req;
  req -> ms [label="item created"]; ms -> ai [label="stage 1"];
  ms -> teams [label="stages 2-3"]; teams -> hr [style=dashed];
  ms -> req [label="status"]; req -> onb [label="Hired"]; onb -> planner;
  req -> bi [style=dotted];
}
