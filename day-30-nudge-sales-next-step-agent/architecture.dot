digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.45, ranksep=0.7, bgcolor="white",
         label=<<b>Day 30 · NUDGE — Next steps, Updates, Due dates, Gentle follow-ups, Evidence</b><br/><font point-size="13" color="#6B7280">A Copilot Studio sales coach with SharePoint lists as a CRM-lite and Teams follow-ups on the right day<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=10, color="#4B5563", fontcolor="#374151", arrowsize=0.7];
  rep [label=<<b>Sales rep</b><br/><font point-size="10">Teams on phone / laptop</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  mgr [label=<<b>Sales manager</b>>, fillcolor="#F3F4F6", color="#6B7280"];
  subgraph cluster_cs { label=<<b>Copilot Studio (standard harness)</b>>; fontsize=13; style="rounded,dashed"; color="#C2410C"; fontcolor="#C2410C";
  agent [label=<<b>NUDGE agent</b><br/><font point-size="10">generative orchestration</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  kn [label=<<b>Knowledge</b><br/><font point-size="10">sales playbook page</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  tools [label=<<b>SharePoint connector tools</b><br/><font point-size="10">Get items · Create item · Update item</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  }
  subgraph cluster_m365 { label=<<b>Microsoft 365</b>>; fontsize=13; style="rounded,dashed"; color="#0369A1"; fontcolor="#0369A1";
  teams [label=<<b>Teams chat with NUDGE</b><br/><font point-size="10">questions + follow-up cards</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  lists [label=<<b>SharePoint lists = CRM-lite</b><br/><font point-size="10">Accounts · Commitments · Activities</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  mail [label=<<b>Outlook</b><br/><font point-size="10">fallback e-mail</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  }
  subgraph cluster_pp { label=<<b>Power Automate (standard connectors)</b>>; fontsize=13; style="rounded,dashed"; color="#7C3AED"; fontcolor="#7C3AED";
  flow [label=<<b>Daily follow-up cloud flow</b><br/><font point-size="10">08:00 weekdays · FollowUpDate = today</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  }
  csv [label=<<b>data/*.csv</b><br/><font point-size="10">fictional sample data</font>>, fillcolor="#FEF9C3", color="#A16207"];
  rep -> teams [label="what next on Contoso?"];
  teams -> agent; agent -> kn [label="next-step rules"];
  agent -> tools [label="read / save commitment\n(after rep confirms)"]; tools -> lists;
  flow -> lists [label="due today?"];
  flow -> teams [label="card as NUDGE:\nhow did it go?"];
  teams -> flow [label="answer", style=dashed]; flow -> lists [label="Outcome · Status"];
  flow -> mail [label="agent not installed", style=dashed];
  lists -> mgr [label="list views / Power BI", style=dotted];
  csv -> lists [style=dotted];
}
