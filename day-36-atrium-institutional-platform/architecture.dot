digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.45, ranksep=0.7, bgcolor="white",
         label=<<b>Day 36 · ATRIUM — Approvals, Templates, Records, Institutional knowledge, Unified hubs, Modules</b><br/><font point-size="13" color="#6B7280">A bilingual institutional platform on SharePoint and Power Platform: one information model, one approval engine, AI last<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=10, color="#4B5563", fontcolor="#374151", arrowsize=0.7];
  staff [label=<<b>Staff (EN / AR)</b><br/><font point-size="10">two entities · one tenant</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  subgraph cluster_sp { label=<<b>SharePoint Online (hubs)</b>>; fontsize=13; style="rounded,dashed"; color="#0369A1"; fontcolor="#0369A1";
  home [label=<<b>Home hub</b><br/><font point-size="10">news · policies · multilingual</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  gov [label=<<b>Governance hub</b><br/><font point-size="10">board · strategy · decisions</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  rec [label=<<b>Records hub</b><br/><font point-size="10">Correspondence · Archive</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  ops [label=<<b>Operations hub</b><br/><font point-size="10">HR · finance · procurement · service desk</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  aca [label=<<b>Academic hub</b><br/><font point-size="10">programmes · research · quality</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  kn [label=<<b>Knowledge hub</b><br/><font point-size="10">wiki · FAQ</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  }
  terms [label=<<b>Term store + content types</b><br/><font point-size="10">Entity · Unit · Doc type · Classification</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  subgraph cluster_pp { label=<<b>Power Platform (managed environment)</b>>; fontsize=13; style="rounded,dashed"; color="#7C3AED"; fontcolor="#7C3AED";
  ref [label=<<b>Issue reference flow</b><br/><font point-size="10">Counters list · ETag · concurrency 1</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  appr [label=<<b>Shared approval engine</b><br/><font point-size="10">matrix list · escalation</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  pbi [label=<<b>Power BI</b><br/><font point-size="10">KPIs · registers</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  }
  teams [label=<<b>Teams</b><br/><font point-size="10">approvals · service desk cards</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  ai [label=<<b>Copilot Studio assistant</b><br/><font point-size="10">phase 5 · permission-trimmed</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  sor [label=<<b>ERP · Student info system</b><br/><font point-size="10">stay independent · read-only reports</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  repo [label=<<b>Repo</b><br/><font point-size="10">modules.csv · build order<br/>numbering tests · RTL checklist</font>>, fillcolor="#FEF9C3", color="#A16207"];
  staff -> home; home -> gov [style=invis]; staff -> teams;
  rec -> ref [label="new letter"]; ref -> appr [label="outgoing / memo"]; appr -> teams [label="approve"];
  ops -> appr; gov -> appr [style=dashed];
  terms -> rec [style=dotted]; terms -> ops [style=dotted]; terms -> aca [style=dotted];
  gov -> pbi [style=dashed]; sor -> pbi [style=dashed, label="read-only"];
  ai -> kn [label="grounded on"]; ai -> home [style=dashed];
  repo -> ref [style=dotted];
}
