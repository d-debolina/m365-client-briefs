digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.45, ranksep=0.7, bgcolor="white",
         label=<<b>Day 16 · BRIDGE — Bound to Role, Identity &amp; Data, Guarded End-to-end</b><br/><font point-size="13" color="#6B7280">A Copilot Studio agent inside any web app: SSO, signed page context, and per-user rights all the way down<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=10, color="#4B5563", fontcolor="#374151", arrowsize=0.7];
  tech [label=<<b>Technician</b><br/><font point-size="10">browser, ticket #1007</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  subgraph cluster_itsm { label=<<b>Self-hosted ITSM</b>>; fontsize=13; style="rounded,dashed"; color="#A16207"; fontcolor="#A16207";
  panel [label=<<b>Chat panel</b><br/><font point-size="10">Agents SDK client (JS)</font>>, fillcolor="#FEF9C3", color="#A16207"];
  plugin [label=<<b>Plugin backend</b><br/><font point-size="10">checks rights · signs context</font>>, fillcolor="#FEF9C3", color="#A16207"];
  }
  subgraph cluster_az { label=<<b>Azure / Entra</b>>; fontsize=13; style="rounded,dashed"; color="#0F766E"; fontcolor="#0F766E";
  entra [label=<<b>Entra ID</b><br/><font point-size="10">SSO · on-behalf-of</font>>, fillcolor="#E0F7F4", color="#0F766E"];
  mcp [label=<<b>ITSM MCP server</b><br/><font point-size="10">verify ctx · entity rights · audit</font>>, fillcolor="#E0F7F4", color="#0F766E"];
  kv [label=<<b>Key Vault</b><br/><font point-size="10">context signing key</font>>, fillcolor="#E0F7F4", color="#0F766E"];
  }
  subgraph cluster_cs { label=<<b>Copilot Studio</b>>; fontsize=13; style="rounded,dashed"; color="#C2410C"; fontcolor="#C2410C";
  agent [label=<<b>Support agent</b><br/><font point-size="10">summarise · next steps</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  }
  db [label=<<b>ITSM database</b><br/><font point-size="10">tickets per customer entity</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  tech -> panel; plugin -> panel [label="signed context"]; panel -> entra [label="sign-in", style=dashed];
  panel -> agent [label="user token + ticketContext event"]; agent -> mcp [label="tool call (OBO)"];
  mcp -> db [label="as the technician"]; kv -> plugin [style=dotted]; kv -> mcp [style=dotted]; entra -> mcp [style=dotted, label="validate token"];
}
