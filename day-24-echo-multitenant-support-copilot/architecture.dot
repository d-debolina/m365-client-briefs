digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.45, ranksep=0.7, bgcolor="white",
         label=<<b>Day 24 · ECHO — Embedded, Cross-tenant-safe, Handoff-ready Operator</b><br/><font point-size="13" color="#6B7280">Multi-tenant AI support copilot: one platform, many customers, zero data crossing between them<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=10, color="#4B5563", fontcolor="#374151", arrowsize=0.7];
  cust [label=<<b>End customers</b><br/><font point-size="10">website widget per tenant</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  subgraph cluster_az { label=<<b>Azure (SaaS provider)</b>>; fontsize=13; style="rounded,dashed"; color="#0F766E"; fontcolor="#0F766E";
  gw [label=<<b>API + auth</b><br/><font point-size="10">tenantId from token</font>>, fillcolor="#E0F7F4", color="#0F766E"];
  orch [label=<<b>Agent orchestrator</b><br/><font point-size="10">Foundry Agent Service / own code</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  srch [label=<<b>Azure AI Search</b><br/><font point-size="10">tenantId security filter</font>>, fillcolor="#E0F7F4", color="#0F766E"];
  llm [label=<<b>Azure OpenAI</b><br/><font point-size="10">answers with citations</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  tools [label=<<b>Tool router</b><br/><font point-size="10">per-tenant allow-list</font>>, fillcolor="#E0F7F4", color="#0F766E"];
  obs [label=<<b>Telemetry + eval</b><br/><font point-size="10">golden set · isolation tests</font>>, fillcolor="#FEF9C3", color="#A16207"];
  }
  tkb [label=<<b>Tenant knowledge</b><br/><font point-size="10">uploaded docs</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  human [label=<<b>Human support</b><br/><font point-size="10">tenant's own team (email/Teams)</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  cust -> gw; gw -> orch [label="tenant context"]; orch -> srch [label="filter tenantId"]; tkb -> srch [label="index"];
  orch -> llm; orch -> tools; orch -> human [label="handoff + summary", style=dashed]; orch -> obs [style=dotted];
}
