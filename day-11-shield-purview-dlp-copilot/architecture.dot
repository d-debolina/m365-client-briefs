digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.45, ranksep=0.7, bgcolor="white",
         label=<<b>Day 11 · SHIELD — Simulate, Hunt, Inform, Enforce, Label, Dashboard</b><br/><font point-size="13" color="#6B7280">Purview DLP for the Copilot era: Copilot first, then email and files, then endpoints<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=10, color="#4B5563", fontcolor="#374151", arrowsize=0.7];
  owners [label=<<b>Data owners</b><br/><font point-size="10">workshops · register</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  subgraph cluster_pv { label=<<b>Microsoft Purview</b>>; fontsize=13; style="rounded,dashed"; color="#C2410C"; fontcolor="#C2410C";
  labels [label=<<b>Sensitivity labels</b><br/><font point-size="10">taxonomy</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  sit [label=<<b>SITs</b><br/><font point-size="10">custom regex · keywords · EDM</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  pol [label=<<b>DLP policies</b><br/><font point-size="10">simulate → warn → block</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  ae [label=<<b>Activity explorer</b><br/><font point-size="10">+ alerts</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  }
  subgraph cluster_loc { label=<<b>Locations</b>>; fontsize=13; style="rounded,dashed"; color="#0369A1"; fontcolor="#0369A1";
  cop [label=<<b>Microsoft 365 Copilot</b><br/><font point-size="10">labels excluded · prompts blocked</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  exo [label=<<b>Exchange · Teams</b><br/><font point-size="10">tips · justify</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  spo [label=<<b>SharePoint · OneDrive</b><br/><font point-size="10">external sharing</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  dev [label=<<b>Endpoints</b><br/><font point-size="10">USB · upload · paste to AI sites</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  }
  bi [label=<<b>Power BI</b><br/><font point-size="10">KPI pack</font>>, fillcolor="#FEF9C3", color="#A16207"];
  owners -> labels; owners -> sit; labels -> pol; sit -> pol;
  pol -> cop [label="wave 1"]; pol -> exo [label="wave 2"]; pol -> spo [label="wave 2"]; pol -> dev [label="wave 3"];
  cop -> ae [style=dashed]; exo -> ae [style=dashed]; spo -> ae [style=dashed]; dev -> ae [style=dashed]; ae -> bi;
}
