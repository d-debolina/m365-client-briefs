digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.45, ranksep=0.7, bgcolor="white",
         label=<<b>Day 10 · TRIAD — Three Routed, Independent Agents, Delivered</b><br/><font point-size="13" color="#6B7280">One front door, three processes: child vs connected agents with shared state in Dataverse<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=10, color="#4B5563", fontcolor="#374151", arrowsize=0.7];
  user [label=<<b>Employee</b><br/><font point-size="10">Teams / Copilot</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  subgraph cluster_cs { label=<<b>Copilot Studio (one environment)</b>>; fontsize=13; style="rounded,dashed"; color="#C2410C"; fontcolor="#C2410C";
  main [label=<<b>TRIAD Concierge</b><br/><font point-size="10">main agent · generative orchestration</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  buyer [label=<<b>BUYER</b><br/><font point-size="10">child agent · purchases</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  }
  subgraph cluster_it { label=<<b>Owned by IT</b>>; fontsize=13; style="rounded,dashed"; color="#C2410C"; fontcolor="#C2410C";
  key [label=<<b>KEYMASTER</b><br/><font point-size="10">connected agent · access</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  }
  subgraph cluster_hr { label=<<b>Owned by HR</b>>; fontsize=13; style="rounded,dashed"; color="#C2410C"; fontcolor="#C2410C";
  leave [label=<<b>LEAVE</b><br/><font point-size="10">connected agent · history OFF</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  }
  subgraph cluster_pp { label=<<b>Power Platform</b>>; fontsize=13; style="rounded,dashed"; color="#7C3AED"; fontcolor="#7C3AED";
  dv [label=<<b>Dataverse</b><br/><font point-size="10">triad_request (shared state)</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  flows [label=<<b>Agent flows</b><br/><font point-size="10">multistage approvals</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  }
  teams [label=<<b>Teams approvals</b><br/><font point-size="10">manager · Finance · owner</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  user -> main;
  main -> buyer [label="purchase"]; main -> key [label="access"]; main -> leave [label="leave"];
  buyer -> dv; key -> dv; leave -> dv; main -> dv [label="status (read)", style=dashed];
  buyer -> flows; key -> flows; leave -> flows [style=dashed]; flows -> teams;
}
