digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.45, ranksep=0.7, bgcolor="white",
         label=<<b>Day 26 · STAMP — Submit, Template, Assemble, Make PDF</b><br/><font point-size="13" color="#6B7280">One PDF per Microsoft Forms response, on standard Microsoft 365 licences<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=10, color="#4B5563", fontcolor="#374151", arrowsize=0.7];
  p [label=<<b>Participant</b>>, fillcolor="#F3F4F6", color="#6B7280"];
  team [label=<<b>Enrolment team</b>>, fillcolor="#F3F4F6", color="#6B7280"];
  subgraph cluster_m365 { label=<<b>Microsoft 365</b>>; fontsize=13; style="rounded,dashed"; color="#0369A1"; fontcolor="#0369A1";
  form [label=<<b>Microsoft Forms</b><br/><font point-size="10">enrolment form</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  od [label=<<b>OneDrive for Business</b><br/><font point-size="10">service account · /STAMP-temp</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  lib [label=<<b>SharePoint library</b><br/><font point-size="10">Enrolments · metadata</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  mail [label=<<b>Outlook / Teams</b><br/><font point-size="10">PDF + failure alerts</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  }
  subgraph cluster_pp { label=<<b>Power Automate (standard connectors)</b>>; fontsize=13; style="rounded,dashed"; color="#7C3AED"; fontcolor="#7C3AED";
  flow [label=<<b>STAMP cloud flow</b><br/><font point-size="10">Try / Catch scopes</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  html [label=<<b>Compose HTML</b><br/><font point-size="10">template + encoded answers</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  }
  word [label=<<b>Route B (premium)</b><br/><font point-size="10">Word template → PDF</font>>, fillcolor="#FEF9C3", color="#A16207"];
  tpl [label=<<b>enrolment.html</b><br/><font point-size="10">repo template</font>>, fillcolor="#FEF9C3", color="#A16207"];
  p -> form [label="submit"]; form -> flow [label="new response"];
  flow -> html; tpl -> html [style=dotted];
  html -> od [label="Create file .html"]; od -> od [label="Convert file → PDF"];
  od -> lib [label="Create file .pdf"]; flow -> od [label="delete temp", style=dashed];
  lib -> mail; mail -> team;
  flow -> word [label="alternative", style=dotted];
}
