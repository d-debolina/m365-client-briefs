digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.45, ranksep=0.7, bgcolor="white",
         label=<<b>Day 27 · SWEEP — Scan, Weigh, Elect, Evacuate, Prove</b><br/><font point-size="13" color="#6B7280">Safe SharePoint and OneDrive duplicate cleanup: hash, keep the newest, quarantine, prove<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=10, color="#4B5563", fontcolor="#374151", arrowsize=0.7];
  own [label=<<b>Business owner</b><br/><font point-size="10">signs off rules + REVIEW items</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  adm [label=<<b>Consultant</b><br/><font point-size="10">test first, then production</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  subgraph cluster_m365 { label=<<b>Microsoft 365</b>>; fontsize=13; style="rounded,dashed"; color="#0369A1"; fontcolor="#0369A1";
  od [label=<<b>OneDrive + SharePoint</b><br/><font point-size="10">~1.5 TB, sync duplicates</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  mg [label=<<b>Microsoft Graph</b><br/><font point-size="10">delta · quickXorHash · move</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  q [label=<<b>_SWEEP-Quarantine</b><br/><font point-size="10">30-day waiting room</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  rb [label=<<b>Recycle bin</b><br/><font point-size="10">up to 93 days</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  ver [label=<<b>Version storage report</b><br/><font point-size="10">what-if, then trim</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  }
  subgraph cluster_kit { label=<<b>SWEEP scripts</b>>; fontsize=13; style="rounded,dashed"; color="#A16207"; fontcolor="#A16207";
  inv [label=<<b>export_inventory.py</b><br/><font point-size="10">Scan</font>>, fillcolor="#FEF9C3", color="#A16207"];
  plan [label=<<b>find_duplicates.py</b><br/><font point-size="10">Weigh + Elect</font>>, fillcolor="#FEF9C3", color="#A16207"];
  apply [label=<<b>apply_plan.py</b><br/><font point-size="10">Evacuate (dry run first)</font>>, fillcolor="#FEF9C3", color="#A16207"];
  }
  proof [label=<<b>Prove</b><br/><font point-size="10">cleanup-plan.csv · apply-log.csv<br/>before/after report</font>>, fillcolor="#FEF9C3", color="#A16207"];
  adm -> inv; inv -> mg [label="read-only delta"]; od -> mg;
  inv -> plan [label="inventory.csv"]; plan -> own [label="REVIEW rows"];
  own -> apply [label="sign-off"]; apply -> mg [label="PATCH parentReference"]; mg -> q [style=dashed];
  q -> rb [label="after 30 days + sign-off"]; od -> ver [style=dotted];
  apply -> proof; plan -> proof;
}
