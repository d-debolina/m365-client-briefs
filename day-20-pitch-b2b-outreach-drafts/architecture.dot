digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.45, ranksep=0.7, bgcolor="white",
         label=<<b>Day 20 · PITCH — Personalised, Inspected, Tailored, Checked, Human-sent</b><br/><font point-size="13" color="#6B7280">AI-drafted outreach from Excel: the flow writes drafts, a person decides what gets sent<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=10, color="#4B5563", fontcolor="#374151", arrowsize=0.7];
  sales [label=<<b>Salesperson</b><br/><font point-size="10">owns the list</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  subgraph cluster_m365 { label=<<b>Microsoft 365</b>>; fontsize=13; style="rounded,dashed"; color="#0369A1"; fontcolor="#0369A1";
  xl [label=<<b>prospects.xlsx</b><br/><font point-size="10">table Prospects + Offer</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  ol [label=<<b>Outlook Drafts</b><br/><font point-size="10">human edits + sends</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  tm [label=<<b>Teams</b><br/><font point-size="10">'12 drafts ready, 3 flagged'</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  }
  subgraph cluster_pp { label=<<b>Power Automate</b>>; fontsize=13; style="rounded,dashed"; color="#7C3AED"; fontcolor="#7C3AED";
  flow [label=<<b>Cloud flow</b><br/><font point-size="10">status = New, top 20</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  pr [label=<<b>Run a prompt</b><br/><font point-size="10">draft-outreach → JSON</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  }
  prospect [label=<<b>Prospect</b><br/><font point-size="10">only after a human sends</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  sales -> xl; xl -> flow [label="list rows"]; flow -> pr; pr -> flow [style=dashed, label="subject, body, flags"];
  flow -> ol [label="draft (never send)"]; flow -> xl [label="update status", style=dashed]; flow -> tm; ol -> sales [style=dashed]; sales -> prospect [label="send"];
}
