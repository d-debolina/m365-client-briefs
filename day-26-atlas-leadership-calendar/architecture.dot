digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.45, ranksep=0.7, bgcolor="white",
         label=<<b>Day 26 · ATLAS — Annual Timeline of Leadership Activities &amp; Schedules</b><br/><font point-size="13" color="#6B7280">Year-at-a-glance canvas app on one SharePoint list, running as a Teams tab<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=10, color="#4B5563", fontcolor="#374151", arrowsize=0.7];
  lead [label=<<b>Leadership team</b><br/><font point-size="10">view only</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  ea [label=<<b>Executive assistants</b><br/><font point-size="10">ATLAS Editors</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  subgraph cluster_m365 { label=<<b>Microsoft 365</b>>; fontsize=13; style="rounded,dashed"; color="#0369A1"; fontcolor="#0369A1";
  teams [label=<<b>Teams channel tab</b><br/><font point-size="10">desktop · tablet · mobile</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  list [label=<<b>SharePoint list</b><br/><font point-size="10">Leadership_Calendar<br/>15 categories · validation</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  eds [label=<<b>ATLAS_Editors list</b><br/><font point-size="10">shows Edit / New buttons</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  grp [label=<<b>SharePoint groups</b><br/><font point-size="10">Read · Contribute</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  }
  subgraph cluster_pp { label=<<b>Power Platform (standard connectors only)</b>>; fontsize=13; style="rounded,dashed"; color="#7C3AED"; fontcolor="#7C3AED";
  app [label=<<b>ATLAS canvas app</b><br/><font point-size="10">3 × 4 month grid · filters<br/>details panel · form</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  col [label=<<b>colYear / FilteredYear</b><br/><font point-size="10">one year in memory</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  }
  doc [label=<<b>Handover note</b><br/><font point-size="10">add category · grant rights</font>>, fillcolor="#FEF9C3", color="#A16207"];
  lead -> teams; ea -> teams; teams -> app [label="Power Apps tab"];
  app -> list [label="delegable date filter"]; list -> col [label="~100 rows", style=dashed]; col -> app [style=dashed];
  app -> eds [label="IsEditor?"]; app -> list [label="SubmitForm (editors)", style=bold];
  grp -> list [label="enforced server-side", style=dotted];
  doc -> ea [style=dotted];
}
