digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.45, ranksep=0.7, bgcolor="white",
         label=<<b>Day 4 · MATCH — Making Applicants &amp; Talent Click</b><br/><font point-size="13" color="#6B7280">CV extraction and scoring with AI Builder prompts, recruiter stays in control<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=10, color="#4B5563", fontcolor="#374151", arrowsize=0.7];
  cand [label=<<b>Applicants</b>>, fillcolor="#F3F4F6", color="#6B7280"];
  rec [label=<<b>Recruiter</b>>, fillcolor="#F3F4F6", color="#6B7280"];
  subgraph cluster_m365 { label=<<b>Microsoft 365</b>>; fontsize=13; style="rounded,dashed"; color="#0369A1"; fontcolor="#0369A1";
  lib [label=<<b>SharePoint library</b><br/><font point-size="10">CVs (.docx / .pdf)</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  list [label=<<b>Candidates list</b><br/><font point-size="10">structured fields + score</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  teams [label=<<b>Teams</b><br/><font point-size="10">shortlist ready</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  }
  subgraph cluster_pp { label=<<b>Power Platform</b>>; fontsize=13; style="rounded,dashed"; color="#7C3AED"; fontcolor="#7C3AED";
  flow [label=<<b>Cloud flow</b><br/><font point-size="10">file created trigger</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  p1 [label=<<b>AI Builder prompt</b><br/><font point-size="10">extract-cv → JSON</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  p2 [label=<<b>AI Builder prompt</b><br/><font point-size="10">score-candidate vs JD</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  }
  jd [label=<<b>job-description.md</b>>, fillcolor="#FEF9C3", color="#A16207"];
  cand -> lib [label="upload CV"]; lib -> flow; flow -> p1 [label="file text"];
  p1 -> flow [label="JSON", style=dashed]; flow -> p2; jd -> p2 [style=dotted];
  p2 -> list [label="score + reasons"]; list -> teams; teams -> rec;
  rec -> list [label="accept / override", style=dashed];
}
