digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.45, ranksep=0.7, bgcolor="white",
         label=<<b>Day 21 · LIFT — Locate, Inspect, Flatten, Transform</b><br/><font point-size="13" color="#6B7280">Classic to modern SharePoint: assess, archive what's dead, modernize in place, restructure the rest<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=10, color="#4B5563", fontcolor="#374151", arrowsize=0.7];
  classic [label=<<b>Classic sites</b><br/><font point-size="10">subsites · publishing · wiki pages · 2013 workflows</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  assess [label=<<b>M365 Assessment tool</b><br/><font point-size="10">+ plan_waves.py</font>>, fillcolor="#FEF9C3", color="#A16207"];
  subgraph cluster_w { label=<<b>Waves</b>>; fontsize=13; style="rounded,dashed"; color="#A16207"; fontcolor="#A16207";
  arch [label=<<b>Wave 0: Archive</b><br/><font point-size="10">idle 2+ years</font>>, fillcolor="#FEF9C3", color="#A16207"];
  inp [label=<<b>Waves 1–2: In place</b><br/><font point-size="10">groupify + ConvertTo-PnPPage</font>>, fillcolor="#FEF9C3", color="#A16207"];
  rs [label=<<b>Wave 3: Restructure</b><br/><font point-size="10">ShareGate → flat sites</font>>, fillcolor="#FEF9C3", color="#A16207"];
  }
  subgraph cluster_spo { label=<<b>Modern SharePoint</b>>; fontsize=13; style="rounded,dashed"; color="#0369A1"; fontcolor="#0369A1";
  hub [label=<<b>Hub</b><br/><font point-size="10">navigation · theme</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  team [label=<<b>Group-connected team sites</b><br/><font point-size="10">Teams-ready</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  m365a [label=<<b>Microsoft 365 Archive</b><br/><font point-size="10">cold sites</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  }
  pa [label=<<b>Power Automate</b><br/><font point-size="10">replaces 2013 workflows</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  classic -> assess; assess -> arch; assess -> inp; assess -> rs; arch -> m365a; inp -> team; rs -> team [label="new flat sites"];
  team -> hub [dir=none, label="associate"]; inp -> pa [style=dashed, label="workflows"];
}
