digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.45, ranksep=0.7, bgcolor="white",
         label=<<b>Day 21 · TALLY — Track, Assign, List, Log, Yes/no-go</b><br/><font point-size="13" color="#6B7280">A Microsoft Lists validation tracker for an Azure migration: no evidence, no green tick<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=10, color="#4B5563", fontcolor="#374151", arrowsize=0.7];
  team [label=<<b>Migration team</b><br/><font point-size="10">owners per workload</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  subgraph cluster_m365 { label=<<b>Microsoft 365</b>>; fontsize=13; style="rounded,dashed"; color="#0369A1"; fontcolor="#0369A1";
  list [label=<<b>Microsoft List</b><br/><font point-size="10">120 checks · evidence required</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  lib [label=<<b>Evidence library</b><br/><font point-size="10">PDF / screenshots</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  }
  teams [label=<<b>Teams</b><br/><font point-size="10">reminders · alerts · go/no-go</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  subgraph cluster_pp { label=<<b>Power Automate (standard)</b>>; fontsize=13; style="rounded,dashed"; color="#7C3AED"; fontcolor="#7C3AED";
  rem [label=<<b>Monday reminder</b><br/><font point-size="10">per owner</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  alert [label=<<b>Failed/blocked alert</b><br/><font point-size="10">trigger condition</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  gng [label=<<b>Go/no-go snapshot</b><br/><font point-size="10">per workload</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  }
  az [label=<<b>Azure workloads</b><br/><font point-size="10">being migrated</font>>, fillcolor="#E0F7F4", color="#0F766E"];
  team -> list [label="update status"]; team -> lib [label="upload evidence"]; list -> lib [style=dotted, label="link"];
  list -> rem; list -> alert; list -> gng; rem -> teams; alert -> teams; gng -> teams; az -> team [style=dashed, label="test results"];
}
