digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.45, ranksep=0.7, bgcolor="white",
         label=<<b>Day 34 · SWITCH — Scope, Wave-pilot, Import, Test, Cut over, Hand over</b><br/><font point-size="13" color="#6B7280">Google Workspace to Microsoft 365 Business Premium for a small team, with a pilot, a rollback and a proven restore<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=10, color="#4B5563", fontcolor="#374151", arrowsize=0.7];
  team [label=<<b>Agency team</b><br/><font point-size="10">6 people · laptops</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  clients [label=<<b>Client contacts</b><br/><font point-size="10">guests on one folder each</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  subgraph cluster_g { label=<<b>Google (source, kept until sign-off)</b>>; fontsize=13; style="rounded,dashed"; color="#6B7280"; fontcolor="#6B7280";
  gmail [label=<<b>Gmail</b><br/><font point-size="10">mail · calendars · contacts</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  gdrive [label=<<b>Google Drive</b><br/><font point-size="10">My Drive · 4 shared drives</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  cid [label=<<b>Cloud Identity Free</b><br/><font point-size="10">keeps client Ads · GA4 · GTM access</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  }
  subgraph cluster_m365 { label=<<b>Microsoft 365 Business Premium (client-owned tenant)</b>>; fontsize=13; style="rounded,dashed"; color="#0369A1"; fontcolor="#0369A1";
  eac [label=<<b>EAC migration batch</b><br/><font point-size="10">pilot → wave 1 → complete</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  mm [label=<<b>Migration Manager</b><br/><font point-size="10">Google Drive → OneDrive / SharePoint</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  exo [label=<<b>Exchange Online</b><br/><font point-size="10">mailboxes · shared mailbox · DL</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  od [label=<<b>OneDrive</b><br/><font point-size="10">personal files</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  sp [label=<<b>SharePoint + Teams</b><br/><font point-size="10">Clients · Studio · Finance sites</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  sec [label=<<b>Entra ID · Intune · Defender</b><br/><font point-size="10">CA policies · compliance · presets</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  bkp [label=<<b>Microsoft 365 Backup</b><br/><font point-size="10">pay-as-you-go · restore test</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  }
  plan [label=<<b>switch_plan.py</b><br/><font point-size="10">batch CSVs · destinations<br/>link replacements · readiness</font>>, fillcolor="#FEF9C3", color="#A16207"];
  gmail -> eac [label="Gmail API"]; eac -> exo;
  gdrive -> mm [label="Microsoft 365 migration app"]; mm -> od; mm -> sp;
  team -> exo [label="after MX cutover"]; team -> sp; team -> cid [style=dashed, label="client Google tools"];
  sec -> team [style=dashed, label="sign-in & device rules"];
  clients -> sp [label="Specific people links"];
  exo -> bkp [style=dotted]; sp -> bkp [style=dotted];
  plan -> eac [style=dotted]; plan -> mm [style=dotted];
}
