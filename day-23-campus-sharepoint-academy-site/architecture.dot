digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.45, ranksep=0.7, bgcolor="white",
         label=<<b>Day 23 · CAMPUS — Courses, Assets, Members, Permissions, Upkeep, Strategy</b><br/><font point-size="13" color="#6B7280">A SharePoint academy site that stays tidy: metadata over folders, groups over people, a governance rhythm<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=10, color="#4B5563", fontcolor="#374151", arrowsize=0.7];
  subgraph cluster_people { label=<<b>Audiences (Entra groups)</b>>; fontsize=13; style="rounded,dashed"; color="#6B7280"; fontcolor="#6B7280";
  own [label=<<b>Academy Owners</b><br/><font point-size="10">2 people</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  tr [label=<<b>Trainers</b><br/><font point-size="10">sg-academy-trainers</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  lr [label=<<b>Learners</b><br/><font point-size="10">sg-all-staff</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  gt [label=<<b>Guest trainers</b><br/><font point-size="10">dedicated group</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  }
  subgraph cluster_site { label=<<b>Academy communication site</b>>; fontsize=13; style="rounded,dashed"; color="#0369A1"; fontcolor="#0369A1";
  home [label=<<b>Home + course pages</b><br/><font point-size="10">page template · roll-ups</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  cm [label=<<b>Course Materials</b><br/><font point-size="10">metadata · Read for learners</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  td [label=<<b>Trainer Drafts</b><br/><font point-size="10">unique permissions</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  rec [label=<<b>Recordings</b><br/><font point-size="10">Stream on SharePoint</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  }
  flow [label=<<b>Approval flow</b><br/><font point-size="10">Drafts → Materials</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  gov [label=<<b>Governance</b><br/><font point-size="10">review-due view · access reviews · retention label</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  lr -> home; lr -> cm [label="read"]; tr -> td [label="edit"]; td -> flow; flow -> cm [label="publish"]; gt -> cm [style=dashed, label="partner folder only"];
  own -> gov [style=dashed]; gov -> cm [style=dotted]; home -> cm [style=dashed, label="roll-up by Course"]; lr -> rec;
}
