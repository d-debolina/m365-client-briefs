digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.45, ranksep=0.7, bgcolor="white",
         label=<<b>Day 32 · PROBE — Prove Records Obey Boundaries End-to-end</b><br/><font point-size="13" color="#6B7280">Security review of a Copilot Studio agent over Salesforce: per-user access, leak tests and evidence<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=10, color="#4B5563", fontcolor="#374151", arrowsize=0.7];
  rep [label=<<b>Signed-in user</b><br/><font point-size="10">rep · manager · compliance</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  rev [label=<<b>Reviewer</b><br/><font point-size="10">runs the test matrix</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  subgraph cluster_m365 { label=<<b>Microsoft 365</b>>; fontsize=13; style="rounded,dashed"; color="#0369A1"; fontcolor="#0369A1";
  m365c [label=<<b>Microsoft 365 Copilot</b><br/><font point-size="10">Teams / Copilot Chat</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  entra [label=<<b>Entra ID</b><br/><font point-size="10">SSO · who is asking</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  purview [label=<<b>Purview audit</b><br/><font point-size="10">Copilot interactions<br/>jailbreak / XPIA flags</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  }
  subgraph cluster_cs { label=<<b>Copilot Studio + Power Platform environment</b>>; fontsize=13; style="rounded,dashed"; color="#C2410C"; fontcolor="#C2410C";
  agent [label=<<b>Sales insights agent</b><br/><font point-size="10">instructions · tools</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  tool [label=<<b>Salesforce connector tools</b><br/><font point-size="10">User authentication<br/>(per-user OAuth connection)</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  ppac [label=<<b>Environment controls</b><br/><font point-size="10">maker credentials off · data policies<br/>transcripts + retention</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  dv [label=<<b>Dataverse</b><br/><font point-size="10">conversation transcripts</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  }
  subgraph cluster_sf { label=<<b>Salesforce org (external)</b>>; fontsize=13; style="rounded,dashed"; color="#6B7280"; fontcolor="#6B7280";
  app [label=<<b>Connected app</b><br/><font point-size="10">Microsoft Power Platform<br/>admin-approved users</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  sec [label=<<b>Profiles · permission sets</b><br/><font point-size="10">sharing rules · role hierarchy<br/>field-level security</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  data [label=<<b>Accounts · Referrals (PHI)</b><br/><font point-size="10">sandbox, fictional data</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  }
  kit [label=<<b>PROBE kit</b><br/><font point-size="10">test_matrix.csv · check_results.py<br/>findings report</font>>, fillcolor="#FEF9C3", color="#A16207"];
  rep -> m365c [label="question"]; m365c -> entra [style=dotted]; m365c -> agent;
  agent -> tool [label="tool call"]; tool -> app [label="as the user"]; app -> sec;
  sec -> data [label="only what this user may see"];
  ppac -> tool [label="no author credentials", style=dashed];
  agent -> dv [label="transcript", style=dashed];
  m365c -> purview [label="audit record", style=dashed];
  rev -> kit; kit -> m365c [label="20 prompts × each test user", style=dotted];
  purview -> kit [label="evidence", style=dotted];
}
