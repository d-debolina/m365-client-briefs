digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.45, ranksep=0.7, bgcolor="white",
         label=<<b>Day 20 · PROOF — Prompt, Review, Own, Organise, Finalise</b><br/><font point-size="13" color="#6B7280">AI-written flow specs: review them like code before Copilot builds them<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=10, color="#4B5563", fontcolor="#374151", arrowsize=0.7];
  biz [label=<<b>Business user</b><br/><font point-size="10">describes the need</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  ai [label=<<b>AI assistant</b><br/><font point-size="10">first draft spec</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  rev [label=<<b>PROOF review</b><br/><font point-size="10">11 checks · acceptance tests</font>>, fillcolor="#FEF9C3", color="#A16207"];
  subgraph cluster_pp { label=<<b>Power Automate</b>>; fontsize=13; style="rounded,dashed"; color="#7C3AED"; fontcolor="#7C3AED";
  cop [label=<<b>Copilot in designer</b><br/><font point-size="10">one scoped change at a time</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  flow [label=<<b>Cloud flow</b><br/><font point-size="10">Try/Catch · idempotent</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  }
  tests [label=<<b>Acceptance tests</b><br/><font point-size="10">5 cases</font>>, fillcolor="#FEF9C3", color="#A16207"];
  biz -> ai; ai -> rev [label="draft"]; biz -> rev [label="answers gaps", style=dashed]; rev -> cop [label="reviewed spec, step by step"];
  cop -> flow; tests -> flow [label="verify", style=dashed]; flow -> rev [label="fix spec", style=dotted];
}
