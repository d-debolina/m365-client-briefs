digraph G {
  graph [rankdir=TB, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.45, ranksep=0.7, bgcolor="white",
         label=<<b>Day 5 · SPRINKLE — Site &amp; Property Reports, INspections, Kit for Landscape Experts</b><br/><font point-size="13" color="#6B7280">Offline-first canvas app; report generated after sync<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=10, color="#4B5563", fontcolor="#374151", arrowsize=0.7];
  tech [label=<<b>Field technician</b><br/><font point-size="10">phone / tablet</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  client [label=<<b>Property client</b>>, fillcolor="#F3F4F6", color="#6B7280"];
  subgraph cluster_pp { label=<<b>Power Platform</b>>; fontsize=13; style="rounded,dashed"; color="#7C3AED"; fontcolor="#7C3AED";
  app [label=<<b>Canvas app (offline)</b><br/><font point-size="10">checklist · photos · signature</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  prof [label=<<b>Offline profile</b><br/><font point-size="10">Clients · Properties<br/>Controllers · Checklist items</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  dv [label=<<b>Dataverse</b><br/><font point-size="10">Inspections · Findings</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  flow [label=<<b>Cloud flow</b><br/><font point-size="10">Dataverse trigger: status = Submitted</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  }
  subgraph cluster_m365 { label=<<b>Microsoft 365</b>>; fontsize=13; style="rounded,dashed"; color="#0369A1"; fontcolor="#0369A1";
  word [label=<<b>Word template</b><br/><font point-size="10">Populate a Microsoft Word template</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  sp [label=<<b>SharePoint</b><br/><font point-size="10">PDF archive</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  mail [label=<<b>Outlook</b><br/><font point-size="10">report to client</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  }
  {rank=same; word; sp; mail; client;}
  tech -> app [label="no signal OK"]; app -> prof [label="local cache"];
  prof -> dv [label="sync when online"]; dv -> flow; flow -> word [label="fill"];
  word -> sp [label="convert to PDF"]; sp -> mail; mail -> client;
}
