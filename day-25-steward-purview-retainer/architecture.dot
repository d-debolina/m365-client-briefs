         label=<<b>Day 25 · STEWARD — the Purview retainer</b><br/><font point-size="13" color="#6B7280">Steady, Tuned, Evidence-based, Watchful, Accountable, Reported, Documented: compliance as a monthly rhythm<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
