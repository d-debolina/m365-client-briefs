digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.45, ranksep=0.7, bgcolor="white",
         label=<<b>Day 14 · LEDGER — Lookup, Engage, Document, Guide, Escalate, Report</b><br/><font point-size="13" color="#6B7280">First production agent for a fintech: SharePoint knowledge + custom CRM connector + governance from day one<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=10, color="#4B5563", fontcolor="#374151", arrowsize=0.7];
  ops [label=<<b>Ops team</b><br/><font point-size="10">Teams</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  subgraph cluster_cs { label=<<b>Copilot Studio (Prod environment)</b>>; fontsize=13; style="rounded,dashed"; color="#C2410C"; fontcolor="#C2410C";
  agent [label=<<b>LEDGER agent</b><br/><font point-size="10">generative orchestration</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  conn [label=<<b>Custom connector</b><br/><font point-size="10">GetMerchant · SearchMerchants<br/>ListTasks · CreateTask (confirm)</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  }
  subgraph cluster_m365 { label=<<b>Microsoft 365</b>>; fontsize=13; style="rounded,dashed"; color="#0369A1"; fontcolor="#0369A1";
  sp [label=<<b>SharePoint site</b><br/><font point-size="10">policies · KYC guide · playbook</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  }
  subgraph cluster_az { label=<<b>Azure</b>>; fontsize=13; style="rounded,dashed"; color="#0F766E"; fontcolor="#0F766E";
  kv [label=<<b>Key Vault</b><br/><font point-size="10">CRM API key</font>>, fillcolor="#E0F7F4", color="#0F766E"];
  }
  crm [label=<<b>Third-party CRM</b><br/><font point-size="10">REST API</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  subgraph cluster_gov { label=<<b>Power Platform governance</b>>; fontsize=13; style="rounded,dashed"; color="#7C3AED"; fontcolor="#7C3AED";
  dlp [label=<<b>Environment DLP</b><br/><font point-size="10">Business: connector, SP, Dataverse</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  alm [label=<<b>Pipelines</b><br/><font point-size="10">Dev → Test → Prod (solution)</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  tr [label=<<b>Dataverse</b><br/><font point-size="10">transcripts · analytics</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  }
  ops -> agent; agent -> sp [label="knowledge (user auth)"]; agent -> conn [label="tools"];
  conn -> crm [label="X-API-Key"]; kv -> conn [label="env variable (secret)", style=dashed];
  dlp -> agent [style=dotted]; alm -> agent [style=dotted]; agent -> tr [style=dashed];
}
