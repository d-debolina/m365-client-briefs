digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.45, ranksep=0.7, bgcolor="white",
         label=<<b>Day 6 · WARDEN — Watch, Audit, Restrict &amp; Detect ENterprise agents</b><br/><font point-size="13" color="#6B7280">Runtime guard for tool calls + tenant-wide agent inventory with risk score<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=10, color="#4B5563", fontcolor="#374151", arrowsize=0.7];
  user [label=<<b>Agent user</b>>, fillcolor="#F3F4F6", color="#6B7280"];
  admin [label=<<b>Platform admin</b>>, fillcolor="#F3F4F6", color="#6B7280"];
  subgraph cluster_cs { label=<<b>Copilot Studio</b>>; fontsize=13; style="rounded,dashed"; color="#C2410C"; fontcolor="#C2410C";
  agents [label=<<b>Agents</b><br/><font point-size="10">generative orchestration</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  etd [label=<<b>External threat detection</b><br/><font point-size="10">before each tool call</font>>, fillcolor="#FFF1E6", color="#C2410C"];
  }
  subgraph cluster_az { label=<<b>Azure</b>>; fontsize=13; style="rounded,dashed"; color="#0F766E"; fontcolor="#0F766E";
  fn [label=<<b>Guard Function</b><br/><font point-size="10">/validate · /analyze-tool-execution</font>>, fillcolor="#E0F7F4", color="#0F766E"];
  rules [label=<<b>risk-rules.json</b><br/><font point-size="10">R01-R06</font>>, fillcolor="#FEF9C3", color="#A16207"];
  arg [label=<<b>Azure Resource Graph</b><br/><font point-size="10">PowerPlatformResources</font>>, fillcolor="#E0F7F4", color="#0F766E"];
  kql [label=<<b>agents-query.kql</b><br/><font point-size="10">risk score per agent</font>>, fillcolor="#FEF9C3", color="#A16207"];
  }
  tool [label=<<b>Tools / connectors</b><br/><font point-size="10">email · delete · HTTP</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  rep [label=<<b>Report</b><br/><font point-size="10">Power BI / Excel</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  user -> agents; agents -> etd [label="planned tool call"];
  etd -> fn [label="1 s timeout"]; rules -> fn [style=dotted];
  fn -> etd [label="blockAction", style=dashed];
  etd -> tool [label="if allowed"];
  admin -> arg [label="run query"]; kql -> arg [style=dotted]; arg -> rep [label="risky agents first"];
}
