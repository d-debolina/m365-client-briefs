digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, pad=0.4, nodesep=0.45, ranksep=0.7, bgcolor="white",
         label=<<b>Day 3 · GRANT — Generic Routing, Approvals, Numbering &amp; Tracking</b><br/><font point-size="13" color="#6B7280">One reusable approval engine on Dataverse, many thin forms on top<br/><font point-size="11"><font color="#7C3AED">■ Power Platform</font>   <font color="#0369A1">■ Microsoft 365</font>   <font color="#0F766E">■ Azure</font>   <font color="#C2410C">■ Copilot / AI</font>   <font color="#A16207">■ Repo files / outputs</font></font></font>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.10", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=10, color="#4B5563", fontcolor="#374151", arrowsize=0.7];
  staff [label=<<b>Staff</b><br/><font point-size="10">16 forms · one portal</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  appr [label=<<b>Approvers</b><br/><font point-size="10">Outlook · Teams · back-office app</font>>, fillcolor="#F3F4F6", color="#6B7280"];
  subgraph cluster_pp { label=<<b>Power Platform – Prod (managed environment)</b>>; fontsize=13; style="rounded,dashed"; color="#7C3AED"; fontcolor="#7C3AED";
  portal [label=<<b>Self-service canvas app</b><br/><font point-size="10">leave · travel · purchase …</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  back [label=<<b>Back-office model-driven app</b><br/><font point-size="10">approvers · admin area</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  parent [label=<<b>Parent flow per form</b><br/><font point-size="10">thin: trigger + 2 calls</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  route [label=<<b>Child flow: Resolve route</b><br/><font point-size="10">matrix · delegation · budget check</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  stage [label=<<b>Child flow: Run stage</b><br/><font point-size="10">approve · return · reject</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  sched [label=<<b>Scheduled flow</b><br/><font point-size="10">reminders · escalation to alternate</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  dv [label=<<b>Dataverse</b><br/><font point-size="10">grt_request · grt_approvalrule · grt_roleholder<br/>grt_delegation · grt_approvalstep (audit)<br/>grt_budgetline · grt_commitment · grt_setting</font>>, fillcolor="#F3E8FF", color="#7C3AED"];
  }
  subgraph cluster_m365 { label=<<b>Microsoft 365</b>>; fontsize=13; style="rounded,dashed"; color="#0369A1"; fontcolor="#0369A1";
  approvals [label=<<b>Approvals connector</b><br/><font point-size="10">custom responses</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  sp [label=<<b>SharePoint</b><br/><font point-size="10">attachments per request</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  pbi [label=<<b>Power BI</b><br/><font point-size="10">budget vs committed vs actual<br/>turnaround per stage</font>>, fillcolor="#E0F2FE", color="#0369A1"];
  }
  subgraph cluster_alm { label=<<b>Delivery</b>>; fontsize=13; style="rounded,dashed"; color="#A16207"; fontcolor="#A16207";
  dev [label=<<b>Dev environment</b><br/><font point-size="10">unmanaged solution</font>>, fillcolor="#FEF9C3", color="#A16207"];
  pipe [label=<<b>Pipelines in Power Platform</b><br/><font point-size="10">managed solution · env variables<br/>service principal owns flows</font>>, fillcolor="#FEF9C3", color="#A16207"];
  }
  staff -> portal; portal -> dv [label="submit"];
  dv -> parent [label="status = Submitted"];
  parent -> route; route -> dv [style=dashed, label="read rules"];
  parent -> stage; stage -> approvals; approvals -> appr;
  stage -> dv [label="audit step"]; sched -> approvals [style=dashed, label="cancel · reassign"];
  appr -> back [style=dotted]; back -> dv;
  portal -> sp [style=dotted, label="files"]; dv -> pbi;
  dev -> pipe; pipe -> dv [style=dotted, label="deploy"];
}
